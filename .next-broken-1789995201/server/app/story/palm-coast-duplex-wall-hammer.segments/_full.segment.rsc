16:["$","div",null,{"className":"mt-10 text-lg leading-8","children":["$undefined",["$","p",null,{"className":"font-medium text-ink","children":"A Palm Coast man hammers a hole through his shared duplex wall and threatens to keep crawling through it to torment his neighbor."}],["$","p",null,{"className":"mt-6 text-ink-soft","children":"Charles Bowden, 58, allegedly used a hammer and an electric string trimmer to punch a softball-sized hole through the wall separating his Palm Coast duplex unit from his neighbor's early on September 6, 2026, shouting threats the whole time. Deputies say Bowden told the neighbor, 'I'm going to be crawling through the walls and figure out ways to make your life hell,' then refused to come out of his unit for more than 90 minutes while the neighbor recorded the threats. He was arrested and charged with burglary with assault or battery and aggravated assault with a deadly weapon without intent to kill, and is being held without bond."}],["$","div",null,{"className":"mt-10 rounded-xl bg-paper-soft p-6","children":[["$","p",null,{"className":"text-sm font-semibold text-ink","children":"Score breakdown"}],["$","div",null,{"className":"mt-5 space-y-4","children":[["$","div","Absurdity",{"children":[["$","div",null,{"className":"mb-1.5 flex items-center justify-between gap-3 text-sm font-medium","children":[["$","span",null,{"children":"Absurdity"}],["$","span",null,{"style":{"color":"#FF6B35"},"children":[21,"/",25]}]]}],["$","div",null,{"className":"h-2.5 w-full overflow-hidden rounded-full bg-line","children":["$","div",null,{"className":"h-full rounded-full","style":{"width":"84%","backgroundColor":"#FF6B35"}}]}]]}],["$","div","Humor",{"children":[["$","div",null,{"className":"mb-1.5 flex items-center justify-between gap-3 text-sm font-medium","children":[["$","span",null,{"children":"Humor"}],["$","span",null,{"style":{"color":"#FFC93C"},"children":[18,"/",25]}]]}],["$","div",null,{"className":"h-2.5 w-full overflow-hidden rounded-full b