5:["$","$1","c",{"children":[["$","main",null,{"className":"min-h-screen bg-paper text-ink","children":[["$","$La",null,{}],["$","section",null,{"className":"mx-auto max-w-3xl px-6 py-16","children":[["$","p",null,{"className":"text-sm font-medium text-flamingo","children":"Legal"}],["$","h1",null,{"className":"mt-3 text-4xl font-black leading-[1.05] tracking-tight md:text-5xl","children":"Privacy Policy"}],["$","p",null,{"className":"mt-4 text-sm text-ink-soft","children":"Last updated September 2026."}],["$","div",null,{"className":"mt-10 space-y-8 text-lg leading-relaxed text-ink-soft","children":[["$","div",null,{"children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"The short version"}],["$","p",null,{"className":"mt-2","children":["There are no accounts on this site, no login, and no tracking or advertising scripts. The only information we ever receive from you is what you choose to type into the story link(s) and optional note fields on the"," ",["$","a",null,{"href":"/suggest","className":"font-semibold text-sunset-dark underline underline-offset-2","children":"Suggest"}]," ","page, and standard web server logs that any hosted site generates."]}]]}],["$","div",null,{"children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"What we collect from the Suggest form"}],["$","p",null,{"className":"mt-2","children":"When you submit a story link, we store the URL(s) you paste and any optional note you add in a private queue, so an automated review process can check the story before anything is added to the site. We don't ask for your name, email, or any other identifying information, and the form doesn't require an account. Submissions that pass verification become part of the public story archive; submissions that don't pass are simply discarded."}],["$","p",null,{"className":"mt-3","children":"The form also includes a hidden field used to catch automated spam submissions. Real visitors never see or need to interact with it, and it isn't used to identify or track you."}]]}],["$","div",null,{"children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"What we don't do"}],["$","p",null,{"className":"mt-2","children":"We don't use cookies for tracking, analytics scripts, ad networks, or any third-party service that profiles visitors across sites. We don't sell or share data with anyone, because we don't collect enough of it to sell in the first place."}]]}],["$","div",null,{"children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Server logs"}],["$","p",null,{"className":"mt-2","children":"Like any website, ours is hosted by an infrastructure provider that automatically logs basic technical information for every request (such as IP address, browser type, and the page requested) for security and reliability purposes. This is standard web hosting behavior, not something specific to this site, and we don't separately access or analyze it for tracking purposes."}]]}],["$","div",null,{"children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Children's privacy"}],["$","p",null,{"className":"mt-2","children":"This site isn't directed at children, and we don't knowingly collect information from anyone under 13."}]]}],["$","div",null,{"children":[["$","h2",null,{"className":"text-xl font-bold text-ink","children":"Changes to this policy"}],["$","p",null,{"className":"mt-2","children":"If what we collect ever changes, we'll update this page and the date above."}]]}]]}]]}]]}],[["$","script","script-0",{"src":"/_next/static/chunks/0dtq8gq6kmvco.js","async":true,"nonce":"$undefined"}]],["$","$Lb",null,{"children":["$","$c",null,{"name":"Next.MetadataOutlet","children":"$@d"}]}]]}]
